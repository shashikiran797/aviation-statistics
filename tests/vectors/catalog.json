{"facts": {"airline_monthly": {"label": "Airline monthly traffic", "table": "fact_airline_monthly", "grain": "airline x fiscal month x segment (domestic | international)", "description": "Scheduled traffic and operating statistics reported by Indian airlines to DGCA (ICAO ATR Form A). Fiscal years run April-March. Rows for aggregate entities (ALL SCHEDULED INDIAN AIRLINES, national, private) are totals of airlines and are excluded by default so nothing is double counted.\n", "joins": {"dim_airline": ["airline_key", "dim_airline", "airline_key"], "dim_period": ["period_key", "dim_period", "period_key"], "dim_segment": ["segment_key", "dim_segment", "segment_key"]}, "default_filters": [{"dim": "airline_type", "op": "in", "values": ["Airline"]}], "dimensions": ["airline", "airline_type", "fy", "quarter", "month", "period", "segment"], "measures": ["pax", "departures", "pax_load_factor", "pax_per_departure", "pax_km", "ask", "hours", "kms", "cargo_t", "tkm_total", "atk", "weight_load_factor"]}}, "dimensions": {"airline": {"label": "Airline", "table": "dim_airline", "column": "airline", "kind": "category", "description": "Operator name (aliases merged, e.g. 'AIR ASIA excel' -> AirAsia India).", "values": ["Air Carnival", "Air Costa", "Air Deccan", "Air Heritage", "Air India", "Air India Express", "Air Odisha", "Air Pegasus", "AirAsia India", "All scheduled Indian airlines", "Alliance Air", "Blue Dart Aviation", "GoAir", "IndiGo", "Jet Airways", "JetLite", "Quikjet Cargo", "Scheduled national airlines", "Scheduled private airlines", "SpiceJet", "Star Air", "TruJet", "Vistara", "Zoom Air"]}, "airline_type": {"label": "Entity type", "table": "dim_airline", "column": "airline_type", "kind": "category", "description": "Airline, or Aggregate for DGCA roll-ups (all scheduled / national / private).", "values": ["Aggregate", "Airline"]}, "fy": {"label": "Fiscal year", "table": "dim_period", "column": "fy", "kind": "category", "ordered": true, "description": "April-March fiscal year, e.g. 2017-18.", "values": ["2014-15", "2015-16", "2016-17", "2017-18", "2018-19"]}, "quarter": {"label": "Fiscal quarter", "table": "dim_period", "column": "quarter", "kind": "category", "ordered": true, "description": "Q1 = Apr-Jun.", "values": ["2014-15 Q1", "2014-15 Q2", "2014-15 Q3", "2014-15 Q4", "2015-16 Q1", "2015-16 Q2", "2015-16 Q3", "2015-16 Q4", "2016-17 Q1", "2016-17 Q2", "2016-17 Q3", "2016-17 Q4", "2017-18 Q1", "2017-18 Q2", "2017-18 Q3", "2017-18 Q4", "2018-19 Q1", "2018-19 Q2", "2018-19 Q3", "2018-19 Q4"]}, "month": {"label": "Month", "table": "dim_period", "column": "month_name", "sort_by": "fy_month_num", "kind": "category", "ordered": true, "description": "Calendar month, ordered April to March.", "values": ["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"]}, "period": {"label": "Month (timeline)", "table": "dim_period", "column": "period", "kind": "time", "ordered": true, "description": "First day of the month; use for time series.", "min": "2014-04-01", "max": "2019-03-01"}, "segment": {"label": "Segment", "table": "dim_segment", "column": "segment", "kind": "category", "description": "Scheduled domestic or international services.", "values": ["Domestic", "International"]}}, "measures": {"pax": {"label": "Passengers carried", "expr": "SUM(f.pax)", "unit": "passengers", "additive": true, "format": "compact"}, "departures": {"label": "Departures", "expr": "SUM(f.departures)", "unit": "flights", "additive": true, "format": "compact"}, "hours": {"label": "Aircraft hours flown", "expr": "SUM(f.hours)", "unit": "hours", "additive": true, "format": "compact"}, "kms": {"label": "Aircraft km flown (thousand)", "expr": "SUM(f.kms_thousand)", "unit": "thousand km", "additive": true, "format": "compact"}, "pax_km": {"label": "Passenger-km performed (million)", "expr": "SUM(f.pax_km_million)", "unit": "million pax-km", "additive": true, "format": "compact"}, "ask": {"label": "Available seat-km (million)", "expr": "SUM(f.ask_million)", "unit": "million seat-km", "additive": true, "format": "compact"}, "cargo_t": {"label": "Cargo carried (tonnes)", "expr": "SUM(f.cargo_t)", "unit": "tonnes", "additive": true, "format": "compact"}, "tkm_total": {"label": "Tonne-km performed (million)", "expr": "SUM(f.tkm_total_million)", "unit": "million tonne-km", "additive": true, "format": "compact"}, "atk": {"label": "Available tonne-km (million)", "expr": "SUM(f.atk_million)", "unit": "million tonne-km", "additive": true, "format": "compact"}, "pax_load_factor": {"label": "Passenger load factor", "expr": "100.0 * SUM(f.pax_km_million) / NULLIF(SUM(f.ask_million), 0)", "unit": "%", "additive": false, "format": "percent", "description": "Passenger-km / available seat-km. Recomputed from sums, never averaged."}, "weight_load_factor": {"label": "Weight load factor", "expr": "100.0 * SUM(f.tkm_total_million) / NULLIF(SUM(f.atk_million), 0)", "unit": "%", "additive": false, "format": "percent"}, "pax_per_departure": {"label": "Passengers per departure", "expr": "SUM(f.pax) * 1.0 / NULLIF(SUM(f.departures), 0)", "unit": "passengers", "additive": false, "format": "number"}}, "dashboards": [], "version": "f4ed777a68", "tables": {"fact_airline_monthly": ["airline_key", "period_key", "segment_key", "departures", "hours", "kms_thousand", "pax", "pax_km_million", "ask_million", "freight_t", "mail_t", "cargo_t", "tkm_total_million", "atk_million", "source_sha"], "dim_airline": ["airline_key", "airline", "airline_type", "first_fy", "last_fy"], "dim_period": ["period_key", "period", "fy", "fy_start_year", "quarter", "month_name", "fy_month_num", "calendar_year"], "dim_segment": ["segment_key", "segment"]}}